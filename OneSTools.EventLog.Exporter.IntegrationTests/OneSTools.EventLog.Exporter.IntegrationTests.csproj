<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <Using Include="Xunit" />
    <ProjectReference Include="../OneSTools.EventLog.Exporter.Core/OneSTools.EventLog.Exporter.Core.csproj" />
    <ProjectReference Include="../OneSTools.EventLog.Exporter/OneSTools.EventLog.Exporter.csproj" />
    <ProjectReference Include="../OneSTools.EventLog.Exporter.Manager/OneSTools.EventLog.Exporter.Manager.csproj" />
    <ProjectReference Include="../OneSTools.EventLog.Exporter.ProcessHarness/OneSTools.EventLog.Exporter.ProcessHarness.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="LegacyEventLogItems.sql" />
    <None Include="../OneSTools.EventLog.Tests/Fixtures/positional-data-8.3.27.json"
          Link="Fixtures/positional-data-8.3.27.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../OneSTools.EventLog.Tests/Fixtures/known-named-data-8.3.27.json"
          Link="Fixtures/known-named-data-8.3.27.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyProcessHarness" AfterTargets="Build">
    <ItemGroup>
      <HarnessFiles Include="../OneSTools.EventLog.Exporter.ProcessHarness/bin/$(Configuration)/net8.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(HarnessFiles)" DestinationFolder="$(OutDir)ProcessHarness" SkipUnchangedFiles="true" />
  </Target>
</Project>
